# Required production settings
# The only host port exposed by the application. Change this only when 8080 is occupied.
APP_PORT=8080
# Database connection used by the API. The defaults use the MariaDB container.
DATABASE_HOST=mariadb
DATABASE_PORT=3306
DATABASE_NAME=luogu_ti
DATABASE_USER=app
# Use a long, random value.
DATABASE_PASSWORD=change-this-to-a-long-random-password
# Required for signing Bearer sessions. Generate at least 32 random bytes.
SESSION_SECRET=change-this-to-a-long-random-session-secret

# Optional settings
TZ=Asia/Shanghai
# Set this only when the default npm registry is unreachable from the server.
NPM_REGISTRY=https://registry.npmjs.org
# Defaults to https://auth.luogu.me when omitted.
CPOAUTH_BASE_URL=https://auth.luogu.me

# Optional S3-compatible CDN upload settings (only needed with the s3-upload profile).
S3_UPLOAD_ENABLED=false
S3_API_BASE_URL=
S3_API_ADMIN_TOKEN=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PREFIX=
S3_UPLOAD_CONCURRENCY=8
S3_FORCE_PATH_STYLE=true
S3_SESSION_TOKEN=
